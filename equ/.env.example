# Django (пример — подставь свои значения)
DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (должно совпадать с docker-compose.yml)
POSTGRES_DB=equipment-system
POSTGRES_USER=equipment-user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Print service
# auto: Windows->win32 (если доступно), иначе tcp (если задан PRINTER_HOST)
PRINTER_BACKEND=auto
# Для tcp: IP/hostname принтера (Zebra обычно слушает 9100)
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
# Для win32:
PRINTER_NAME=ZDesigner ZD220-203dpi ZPL
PRINTER_TIMEOUT=5

# Django -> Print service URL (override hardcoded values in code)
PRINT_SERVICE_URL=http://print:8001/print
PRINT_SERVICE_TIMEOUT=10

# Print service options
PRINTER_TCP_VERIFY=0

# Print service logging/diagnostics
PRINT_SERVICE_LOG_LEVEL=INFO
PRINT_SERVICE_LOG_PAYLOAD_SNIPPET_BYTES=0
PRINT_SERVICE_RETURN_DIAGNOSTICS=0
